# Do not commit .env files containing real credentials.
# Optional. Unset (the default in local/dev) falls back to typed local
# fixtures per adapter in app/lib/*-api.ts — no real backend calls are made.
NEXT_PUBLIC_SUPERX_API_BASE_URL=
# Customer PWA base URL (e.g. https://superx.koden.site). Enables the
# "¿Olvidaste tu contraseña?" link on the login screen.
NEXT_PUBLIC_CUSTOMER_APP_URL=
